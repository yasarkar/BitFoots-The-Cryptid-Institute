# Supabase Configuration
# Retrieve these credentials from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Next.js App URL (used for OAuth redirect callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to HMAC-sign single-use run tokens (SEC-4).
# If unset, SUPABASE_SERVICE_ROLE_KEY is used as the signing secret.
# Set an explicit value in production: any long random string, e.g. `openssl rand -hex 32`.
RUN_TOKEN_SECRET=
